# LLM: OpenAI-compatible endpoint, swappable by env var only (never hardcode
# a provider outside services/api/llm/client.py). Groq primary.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Embeddings: local, CPU, no API key.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Vector store: empty = embedded local Qdrant. Set to http://localhost:6333
# to use the docker-compose Qdrant service instead.
QDRANT_URL=

# Database: matches docker-compose.yml's postgres service credentials.
DATABASE_URL=postgresql://campusflow:campusflow@localhost:5432/campusflow

# Confidence routing (graph/confidence.py, Phase 2)
CONF_ANSWER_THRESHOLD=0.80
CONF_CLARIFY_THRESHOLD=0.55

# Memory (TrueMemory, student profile + episodic recall only)
TRUEMEMORY_DB_PATH=./services/api/truememory.sqlite

# Approval gateway (Phase 5)
AUTO_APPROVE_MAX_RISK=low
